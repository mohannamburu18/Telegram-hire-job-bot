{
  "manifest_version": 3,
  "name": "Lucres AI & TeleHire - Real-Time Smart Autofill & Auto-Apply",
  "version": "2.2.0",
  "description": "Universal ATS autofill engine for Greenhouse, Lever, Ashby, Workday, LinkedIn Easy Apply, and modern job portals. Human-paced typing, 5-layer selector fallback, and 95% ATS profile mapping.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.workday.com/*",
    "https://*.myworkday.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*",
    "https://*.indeed.com/*",
    "https://*.cutshort.io/*",
    "https://*.hirist.com/*",
    "https://*.internshala.com/*",
    "https://*.workable.com/*",
    "https://*.keka.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.workday.com/*",
        "https://*.myworkday.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.linkedin.com/*",
        "https://*.naukri.com/*",
        "https://*.indeed.com/*",
        "https://*.cutshort.io/*",
        "https://*.hirist.com/*",
        "https://*.internshala.com/*",
        "https://*.workable.com/*",
        "https://*.keka.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lucres AI Safe Form Filler"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
