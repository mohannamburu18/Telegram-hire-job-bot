{
  "manifest_version": 3,
  "name": "TeleHire - Real-Time Safe Job Form Filler & Auto-Apply",
  "version": "2.0.0",
  "description": "Real-time safe form filler and multi-step application assistant for LinkedIn Easy Apply, Greenhouse, Lever, Ashby, Workable, Naukri, and modern ATS platforms. Human-paced typing, real-time field mapping, and mandatory manual submission review.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.naukri.com/*",
    "*://*.indeed.com/*",
    "*://*.cutshort.io/*",
    "*://*.hirist.com/*",
    "*://*.foundit.in/*",
    "*://*.internshala.com/*",
    "*://*.wellfound.com/*",
    "*://*.workable.com/*",
    "*://*.lever.co/*",
    "*://*.greenhouse.io/*",
    "*://*.ashbyhq.com/*",
    "*://*.keka.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.naukri.com/*",
        "*://*.indeed.com/*",
        "*://*.cutshort.io/*",
        "*://*.hirist.com/*",
        "*://*.foundit.in/*",
        "*://*.internshala.com/*",
        "*://*.wellfound.com/*",
        "*://*.workable.com/*",
        "*://*.lever.co/*",
        "*://*.greenhouse.io/*",
        "*://*.ashbyhq.com/*",
        "*://*.keka.com/*",
        "*://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TeleHire Real-Time Safe Form Filler"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
